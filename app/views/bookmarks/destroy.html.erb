<h1>Delete bookmark from <%= @list.name %></h1>

<p>Are you sure you want to delete this bookmark?</p>

<%= simple_form_for [@list, @bookmark], method: :destroy do |f| %>
  <%= f.button :submit, "Delete bookmark", data: { turbo_confirm: "Are you sure?" } %>
<% end %>

<%= link_to "Cancel", list_path(@list) %>
